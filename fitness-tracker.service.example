[Unit]
Description=Fitness Tracker App
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/fitness-tracker
EnvironmentFile=/etc/fitness-tracker.env
ExecStart=/usr/bin/python3.11 /home/admin/apps/fitness-tracker/app.py --host 0.0.0.0 --port 8085
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
